# Backend — local (por variables) o Render (DATABASE_URL)
DATABASE_URL=
DB_HOST=localhost
DB_NAME=supertiendas_db
DB_USER=postgres
DB_PASS=password
DB_PORT=5432

# Render asigna RENDER_EXTERNAL_URL automáticamente en el API
# PUBLIC_API_URL=https://tu-api.onrender.com
# CORS_ORIGINS=https://tu-frontend.onrender.com
# SEED_ON_STARTUP=true

# Usuario master (panel admin, no aparece en lista de usuarios; se crea al arrancar el API)
# MASTER_USERNAME=master
# MASTER_PASSWORD=Master@2026Pedidos

# Authentication
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Respaldo (scripts backup_db.py / restore_db.py — ver docs/BACKUP.md)
# BACKUP_DIR=D:\Pedidos mayorista\backups
BACKUP_RETENTION_DAYS=30
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\16\bin

# Notificaciones pedidos cliente (backend)
# WhatsApp vía UltraMsg por sede (Admin → Sedes) o respaldo global:
# ULTRAMSG_INSTANCE_ID=instance12345
# ULTRAMSG_TOKEN=your_ultramsg_token

# SMS opcional vía Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=

# Frontend Configuration (Vite)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=http://localhost:8000
